# AIverse backend configuration - copy to .env and fill
APP_ENV=development

# LLM providers (Gemini is default; Zen, Groq, OpenRouter are automatic fallbacks in order)
ZEN_API_KEY=
ZEN_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Defaults
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=qwen/qwen3.6-27b
TEMPERATURE=0.7
FALLBACK_PROVIDER=openrouter
FALLBACK_MODEL=z-ai/glm-5.2:free
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Runtime
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
