# Nexus backend environment — copy to .env and fill values
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32+char-string

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Postgres later: postgresql+asyncpg://user:pass@localhost:5432/nexus

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nexus
AUTH_RATE_LIMIT=5/minute
REFRESH_RATE_LIMIT=10/minute

# OpenCode Zen API — DEFAULT provider. Fill YOUR key here.
ZEN_API_KEY=your-zen-api-key-here
ZEN_BASE_URL=https://opencode.ai/zen/v1

# Other optional providers (fill if you want them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Defaults
DEFAULT_PROVIDER=zen
DEFAULT_MODEL=deepseek-v4-flash-free

# Embeddings
EMBEDDING_PROVIDER=zen
EMBEDDING_MODEL=text-embedding-3-small
# or: EMBEDDING_PROVIDER=ollama / EMBEDDING_MODEL=nomic-embed-text

# Runtime
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO