# AIverse backend configuration - copy to .env and fill
APP_ENV=development

# LLM providers (Gemini is default; Zen is OpenAI-compatible fallback)
ZEN_API_KEY=
ZEN_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Defaults
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.5-flash
TEMPERATURE=0.7
FALLBACK_PROVIDER=zen
FALLBACK_MODEL=deepseek-v4-flash-free

# Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Runtime
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
